{
  "name": "com.nationalsecurityagency.desktopenvironment",
  "description": "NSA Desktop Environment",
  "author": "Tiziano Tomas Luzi Ramos",
  "main": "electron.cjs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "desktopName": "nsa-desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "build:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "tizianoluziramos",
      "repo": "nsa-electron"
    },
    "appId": "com.nationalsecurityagency.desktopenvironment",
    "productName": "NSA Desktop",
    "compression": "maximum",
    "asar": true,
    "removePackageScripts": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs",
      "package.json",
      "!**/*.ts",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,*.d.ts}",
      "!**/node_modules/.bin",
      "!**/{.eslintrc,.eslintignore,.prettierrc,.editorconfig}"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "syncDesktopName": true
    }
  },
  "devDependencies": {
    "@cursorify/react": "^0.0.43",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "ky": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "serve": "^14.2.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
